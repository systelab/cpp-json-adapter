def version = "0.0.0"
def profile = "vs2022.conanprofile"
def archs = ['x86', 'x86_64']
def configs = ['Debug', 'Release']

@Library('aid-pipeline-utils@1.0.23') _
   
pipeline
{
	agent
	{
		label 'lib-build'
	}

	environment
	{
		PATH = "${env.USERPROFILE}\\.venvs\\conan2\\Scripts;${env.PATH}"
	}

	parameters
	{
		string(	name: 'tag',
				description: 'Version to build (must match the version of the tag that will be checked out), leave blank for checkout of current branch',
				defaultValue: '',
				trim: true)

		booleanParam( name: 'uploadPackage',
					  description: 'Whether or not to upload conan package',
					  defaultValue: false )
	}

	options
	{
		skipDefaultCheckout(true)
		disableConcurrentBuilds()
		buildDiscarder(logRotator(numToKeepStr: '5'))
	}

	stages
	{
		stage('Checkout')
		{
			steps
			{
				cleanupWorkspace()
				script 
				{
					if (params.tag == '')
					{
						checkoutFromGIT()
					}
					else
					{
						version = params.tag
						checkoutFromGIT(scm.userRemoteConfigs[0].url, "v${version}", true)
					}
				}
			}
		}
		
		stage('Build')
		{	
			steps
			{
				script
				{
					bat "conan export-pkg JSONAdapterInterface/conanfile.py --version ${version} --profile:all=${profile}"
					archs.each
					{ arch ->
						configs.each
						{ config ->
							stage("Build ${config}|${arch}")
							{
								def buildFolder = "build/${config}-${arch}"
								bat "conan install JSONAdapterTestUtilities/conanfile.py --version ${version} --output-folder ${buildFolder} --profile:all=${profile} --settings:host arch=${arch} --settings:host build_type=${config} --update"
								bat "conan build JSONAdapterTestUtilities/conanfile.py --version ${version} --output-folder ${buildFolder} --profile:all=${profile} --settings:host arch=${arch} --settings:host build_type=${config}" 
								bat "conan export-pkg JSONAdapterTestUtilities/conanfile.py --version ${version} --output-folder ${buildFolder} --profile:all=${profile} --settings:host arch=${arch} --settings:host build_type=${config}"
								bat "conan test ./test_package/conanfile.py json-adapter-test-utilities/${version} --profile:all=${profile} --settings:host arch=${arch} --settings:host build_type=${config}"
							}
						}
					}
				}
			}
		}

		stage('Deploy')
		{
			when
			{
				expression { params.uploadPackage }
			}
			steps
			{
				script
				{
					bat "conan upload json-adapter-interface/${version} --remote aid-conan-production-local --confirm --force"
					bat "conan upload json-adapter-test-utilities/${version} --remote aid-conan-production-local --confirm --force"
				}
			}
		}
	}

	post
	{
		always
		{
			script
			{
				currentBuild.description = "${version}"
			}
			cleanupWorkspace()
		}
	}
}