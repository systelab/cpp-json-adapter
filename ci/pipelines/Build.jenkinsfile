def common = [:]

@Library('aid-pipeline-utils@1.0.21') _
   
pipeline
{
	agent
	{
		label 'libGen-conan2'
	}

	parameters
	{
        string( name: 'version',
                description: 'version to be generated',
                defaultValue: '1.0.0',
                trim: true )

		separator(name: "Package_Settings", sectionHeader: "Package Settings")
		
		choice( name: 'compiler', 
                choices: ['vs2022'], 
                description: 'Compiler')
                
		 choice( name: 'architecture', 
				choices: ['x86', 'x86_64'],
				description: 'Architecture of the package being built'
				)
				
        string( name: 'configurations',
                description: 'Build configurations to generate',
                defaultValue: 'Release,Debug',
                trim: true )
		
		separator(name: "Package_Upload", sectionHeader: "Package Upload")
		
		string( name: 'conanRemote',
                description: 'Remote to upload the package, uploadPackage must be checked',
                defaultValue: 'aid-conan-production-local',
                trim: true )
				
		booleanParam( name: 'uploadPackage',
                      description: 'Toggles package upload to Artifactory',
                      defaultValue: false)
					  
		booleanParam( name: 'overrideExistingPackage',
                      description: 'Overrides package in Artifactory',
                      defaultValue: false)
					  
	}

	options
	{
		skipDefaultCheckout(true)
		disableConcurrentBuilds()
		buildDiscarder(logRotator(numToKeepStr: '5'))
	}

	stages
	{
		stage('Setup')
		{
			steps
			{
				cleanupWorkspace()
				bat script: "conan remove JSONAdapterInterface/${params.version} --confirm", label: "Remove JSONAdapterInterface from cache"
				bat script: "conan remove JSONAdapterTestUtilities/${params.version} --confirm", label: "Remove JSONAdapterTestUtilities from cache"
				
				checkoutFromGIT()
				script 
				{			
					common.pipelineUtilities = load 'common/pipelineUtilities.groovy'
				}
			}
		}
		
		stage('Prepare package')
		{
			steps
			{
				script
				{
					common.pipelineUtilities.buildConanProfile(params.compiler)
				}
			}
		}
		
		stage('Build')
		{	
			steps
			{
				script
				{
					dir(JSONAdapterInterface)
					{
						bat script: "conan export-pkg . --version=${params.version} -pr:h=../profile", label: 'Exporting JSONAdapterInterface'
					}
					
					params.configurations.split(',').each
					{ config ->
						stage("Build JSONAdapterTestUtilities ${config}|${params.architecture}")
						{
							def buildFolder = "build-${config}-${params.architecture}"
							bat script: "conan build JSONAdapterTestUtilities/conanfile.py --output-folder=${buildFolder} -pr:a=./profile -s:a arch=${params.architecture} -s:a build_type=${config}", label: 'Build JSONAdapter test utilities'
							bat script: "conan test ./test_package/conanfile.py JSONAdapterTestUtilities/${params.version} -s:a arch=${params.architecture} -pr:a=./profile -s:a build_type=${config}", label: 'Testing package'
							
							bat script: "conan export-pkg JSONAdapterTestUtilities/conanfile.py --version=${params.version} --output-folder=${buildFolder} -pr:a=./profile -s:a arch=${params.architecture} -s:a build_type=${config}", label: 'Exporting conan package'							
						}
					}
				}
			}
		}

		stage('Deploy')
		{
			when
			{
				expression { params.uploadPackage }
			}
			steps
			{
				script
				{
					def forceUpload = (params.overrideExistingPackage) ? '--force' : ''
					
					bat "conan upload JSONAdapterInterface/${params.version} -r ${params.conanRemote} ${forceUpload}"
					bat "conan upload JSONAdapterTestUtilities/${params.version} -r ${params.conanRemote} ${forceUpload}"
				}
			}
		}
	}

	post
	{
		always
		{
			script
			{
				currentBuild.description = "${params.version}"
			}
			cleanupWorkspace()
		}
	}
}